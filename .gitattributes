# Normalize line endings to LF in the repo, checkout as-is on Windows
* text=auto eol=lf

# Force LF for these even on Windows
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile* text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
